rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Mesmos e-mails do ACESSOS e ADMINS do index.html (tudo minúsculo)
    function perfis() {
      return {
        'thaisilvacunha@gmail.com': 'thais',
        'email-da-roberta@gmail.com': 'roberta'
      };
    }
    function admins() {
      return ['barukerstore@gmail.com'];
    }

    function email() { return request.auth.token.email.lower(); }
    function logado() { return request.auth != null && request.auth.token.email_verified == true; }
    function isAdmin() { return logado() && email() in admins(); }
    function membro() { return logado() && (email() in perfis() || email() in admins()); }

    match /perfis/{perfil} {
      // as duas (e você) veem os dois planos, pra aba "As duas" funcionar
      allow read: if membro();
      // cada uma só grava o próprio plano; você grava os dois
      allow write: if isAdmin()
        || (logado() && email() in perfis() && perfis()[email()] == perfil);
    }

    // qualquer outra coisa: fechado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
